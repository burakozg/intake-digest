# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# All secrets are env-only — they must never appear in config.yaml.

# --- Required to write into the vault ---------------------------------------
INTAKE_VAULT__COUCHDB_URL=http://couchdb.local:5984
INTAKE_VAULT_COUCHDB_PASSWORD=

# Needed once llm.tiers.reduce (or .map) points at an openrouter/ model, which
# the shipped config.yaml default does for the reduce tier.
INTAKE_OPENROUTER_API_KEY=

# --- API auth (required — fail-closed, see api/auth.py) ---------------------
# Gates every route except /healthz. Pick a long random value:
# `openssl rand -hex 32`.
INTAKE_ADMIN_API_KEY=

# --- Failure notifications (optional) ----------------------------------------
# Only used when notifications.enabled: true in config.yaml.
INTAKE_NTFY_TOKEN=

# Path to the non-secret config file. Defaults to ./config.yaml.
# INTAKE_CONFIG_FILE=/app/config.yaml

# Any config.yaml value can be overridden with INTAKE_<SECTION>__<KEY>:
# INTAKE_TRANSCRIPTION__REMOTE_URL=http://10.0.0.3:8000
